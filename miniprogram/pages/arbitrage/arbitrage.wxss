page {
  background: #f5f7fa;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 0;
  box-sizing: border-box;
}

.header,
.overview-main,
.card-head,
.name-line,
.quick-info,
.detail-row,
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header {
  align-items: flex-start;
  padding: 10rpx 4rpx 28rpx;
}

.title {
  display: block;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 21rpx;
}

.refresh {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 5rpx;
  color: #8a94a6;
  font-size: 18rpx;
}

.refresh-icon {
  color: #3478f6;
  font-size: 27rpx;
}

.overview {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #286ff1, #1658d4);
  box-shadow: 0 14rpx 34rpx rgba(28, 91, 210, 0.2);
  color: #fff;
}

.overview-label {
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
}

.overview-number-line {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
}

.overview-number {
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.1;
}

.overview-unit {
  margin-left: 7rpx;
  font-size: 22rpx;
}

.account-pill {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  padding: 13rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 20rpx;
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.overview-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}

.overview-stat + .overview-stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.16);
}

.stat-value {
  font-size: 29rpx;
  font-weight: 750;
}

.stat-label {
  color: rgba(255, 255, 255, 0.68);
  font-size: 19rpx;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 17rpx 20rpx;
  border-radius: 14rpx;
  background: #fff7e6;
  color: #9a6814;
  font-size: 20rpx;
  line-height: 1.45;
}

.notice-dot {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #f5a623;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.notice-text {
  flex: 1;
}

.filters {
  width: 100%;
  margin: 22rpx 0 18rpx;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 12rpx;
}

.filter {
  flex: none;
  padding: 12rpx 25rpx;
  border-radius: 999rpx;
  background: #e9edf3;
  color: #687386;
  font-size: 22rpx;
}

.filter-active {
  background: #172033;
  color: #fff;
  font-weight: 650;
}

.list-head {
  padding: 0 4rpx 13rpx;
}

.list-title {
  font-size: 23rpx;
  font-weight: 700;
}

.list-count {
  color: #9aa3b1;
  font-size: 20rpx;
}

.fund-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e8ebf0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(31, 43, 64, 0.045);
}

.fund-card-positive {
  border-color: rgba(239, 76, 76, 0.18);
}

.fund-title {
  min-width: 0;
  flex: 1;
}

.name-line {
  justify-content: flex-start;
  gap: 10rpx;
}

.fund-name {
  max-width: 310rpx;
  overflow: hidden;
  color: #182033;
  font-size: 28rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-code {
  display: block;
  margin-top: 7rpx;
  color: #9aa3b1;
  font-size: 19rpx;
}

.signal {
  flex: none;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  font-size: 17rpx;
  font-weight: 650;
}

.signal-ready {
  background: #fff0ef;
  color: #e54848;
}

.signal-verify {
  background: #fff4df;
  color: #cf8617;
}

.signal-watch {
  background: #edf5ff;
  color: #3379da;
}

.signal-closed,
.signal-none {
  background: #f0f2f5;
  color: #7c8796;
}

.edge {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 18rpx;
}

.edge-label {
  color: #9aa3b1;
  font-size: 18rpx;
}

.edge-value {
  margin-top: 3rpx;
  color: #687386;
  font-size: 35rpx;
  font-weight: 800;
}

.edge-positive {
  color: #ed4d4d;
}

.money-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 22rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f2f5;
  border-bottom: 1rpx solid #f0f2f5;
}

.money-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.money-cell + .money-cell {
  border-left: 1rpx solid #edf0f4;
}

.money-value {
  color: #283246;
  font-size: 25rpx;
  font-weight: 750;
}

.money-value.profit {
  color: #ed4d4d;
}

.money-label {
  margin-top: 7rpx;
  color: #9aa3b1;
  font-size: 18rpx;
}

.quick-info {
  justify-content: flex-start;
  padding-top: 17rpx;
  color: #7c8796;
  font-size: 19rpx;
}

.quick-divider {
  margin: 0 9rpx;
  color: #c5cbd4;
}

.expand {
  margin-left: auto;
  color: #3478f6;
}

.details {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 13rpx;
  background: #f7f9fc;
}

.detail-row {
  align-items: flex-start;
  padding: 8rpx 0;
  gap: 20rpx;
}

.detail-label {
  flex: none;
  color: #98a2b1;
  font-size: 19rpx;
}

.detail-value {
  color: #4f5a6d;
  font-size: 20rpx;
  text-align: right;
}

.detail-wrap {
  max-width: 430rpx;
  line-height: 1.45;
}

.cost-line {
  margin-top: 10rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #e8ecf2;
  color: #9aa3b1;
  font-size: 18rpx;
  line-height: 1.5;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  padding: 100rpx 20rpx;
  color: #8b95a5;
  font-size: 22rpx;
}

.state-error {
  color: #697386;
}

.state-title {
  color: #384256;
  font-size: 26rpx;
  font-weight: 700;
}

.state-desc {
  max-width: 560rpx;
  color: #98a2b1;
  line-height: 1.5;
  text-align: center;
}

.retry {
  margin-top: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #3478f6;
  color: #fff;
}

.loader {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #dfe4eb;
  border-top-color: #3478f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.disclaimer {
  padding: 25rpx 24rpx 0;
  color: #a4acb8;
  font-size: 18rpx;
  line-height: 1.5;
  text-align: center;
}

.footer-space {
  height: 45rpx;
}
