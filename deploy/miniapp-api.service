[Unit]
Description=WeChat Mini Program Data API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miniapp
Group=miniapp
WorkingDirectory=/opt/miniapp
EnvironmentFile=-/etc/miniapp-api.env
ExecStart=/opt/miniapp/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/miniapp/data
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
