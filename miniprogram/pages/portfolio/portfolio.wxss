/** portfolio.wxss — 极客暗黑科技风 **/

page {
  background: #000000;
  color: #e8eaed;
}

/* ── 页面容器 ── */
.page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

/* ── 背景装饰 ── */
.bg-grid {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
  z-index: 0;
}

.bg-glow {
  position: fixed;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(120rpx);
  z-index: 0;
}

.bg-glow-top {
  top: -200rpx;
  right: -160rpx;
  background: rgba(59, 130, 246, 0.08);
}

.bg-glow-bottom {
  bottom: 120rpx;
  left: -200rpx;
  background: rgba(239, 68, 68, 0.06);
}

/* ── 顶部 Header ── */
.header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.header-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, 0.8);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}

.header-badge-text {
  font-size: 18rpx;
  color: #22c55e;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.subtitle {
  font-size: 20rpx;
  color: #4b5563;
  letter-spacing: 4rpx;
  font-weight: 500;
}

.demo-tag {
  display: inline-flex;
  margin-top: 8rpx;
  align-self: flex-start;
}

.demo-tag text {
  font-size: 18rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
}

.header-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  padding-top: 8rpx;
}

.meta-label {
  font-size: 18rpx;
  color: #374151;
  letter-spacing: 2rpx;
}

.meta-time {
  font-size: 24rpx;
  color: #6b7280;
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 1rpx;
}

/* ── 加载 / 错误状态 ── */
.state-box {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.state-box-error .state-text {
  color: #ef4444;
}

.state-text {
  font-size: 26rpx;
  color: #4b5563;
  letter-spacing: 1rpx;
}

.loader {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── 分区 ── */
.section {
  position: relative;
  z-index: 1;
  margin-bottom: 44rpx;
}

.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-bar-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-line {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #3b82f6, #1d4ed8);
}

.section-line-cyan {
  background: linear-gradient(180deg, #06b6d4, #0891b2);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #d1d5db;
  letter-spacing: 1rpx;
}

.section-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
}

.section-tag-cyan {
  color: #06b6d4;
  background: rgba(6, 182, 212, 0.1);
  border-color: rgba(6, 182, 212, 0.2);
}

/* ── 卡片通用 ── */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  position: relative;
  background: linear-gradient(135deg, #111116 0%, #0d0d10 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.card-rise {
  border-color: rgba(239, 68, 68, 0.15);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.5),
    0 0 40rpx rgba(239, 68, 68, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.card-fall {
  border-color: rgba(34, 197, 94, 0.15);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.5),
    0 0 40rpx rgba(34, 197, 94, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, #ef4444, #b91c1c);
}

.card-fall .card-accent {
  background: linear-gradient(180deg, #22c55e, #15803d);
}

.card-accent-cyan {
  background: linear-gradient(180deg, #06b6d4, #0891b2) !important;
}

.card-body {
  padding: 28rpx 30rpx;
}

/* ── 美股卡片 ── */
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.symbol-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.symbol {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.cn-name {
  font-size: 22rpx;
  color: #6b7280;
}

.card-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: #f3f4f6;
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 1rpx;
}

/* ── 涨红跌绿 ── */
.change-block {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.change-block-lg {
  padding: 8rpx 20rpx;
}

.rise {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.12);
  border: 1rpx solid rgba(239, 68, 68, 0.2);
}

.fall {
  color: #22c55e;
  background: rgba(34, 197, 94, 0.12);
  border: 1rpx solid rgba(34, 197, 94, 0.2);
}

.change-val {
  font-size: 26rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 0.5rpx;
}

.change-block-lg .change-val {
  font-size: 32rpx;
}

/* ── 来源徽标 ── */
.source-badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
}

.source-badge-live {
  color: #22c55e;
  background: rgba(34, 197, 94, 0.1);
  border: 1rpx solid rgba(34, 197, 94, 0.25);
}

.source-badge-demo {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
  border: 1rpx solid rgba(245, 158, 11, 0.25);
}

/* ── 加密合约卡片 ── */
.crypto-card {
  margin-bottom: 0;
}

.crypto-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.crypto-symbol-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.crypto-symbol {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.crypto-type {
  font-size: 18rpx;
  color: #06b6d4;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.crypto-price-row {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.crypto-price {
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: -1rpx;
}

.crypto-stats {
  display: flex;
  align-items: stretch;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.06);
  margin: 4rpx 0;
}

.stat-label {
  font-size: 18rpx;
  color: #4b5563;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d5db;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.stat-unit {
  font-size: 20rpx;
  color: #6b7280;
  margin-left: 4rpx;
}

/* ── 空状态 ── */
.empty-hint {
  text-align: center;
  padding: 48rpx 0;
}

.empty-hint text {
  font-size: 24rpx;
  color: #374151;
  letter-spacing: 1rpx;
}

.footer-space {
  height: 48rpx;
}
