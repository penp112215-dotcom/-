page {
  background: #0d1118;
  color: #edf2f7;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 0;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 94% 0%, rgba(45, 104, 225, 0.12), transparent 28%),
    #0d1118;
}

.header,
.summary,
.stock-head,
.symbol-line,
.target-row,
.target-actions,
.news-head,
.search-result,
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header {
  align-items: flex-start;
  padding: 8rpx 4rpx 26rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 6rpx;
  color: #4588ff;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  display: block;
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
}

.subtitle {
  display: block;
  margin-top: 7rpx;
  color: #647084;
  font-size: 20rpx;
}

.add-button {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 7rpx;
  padding: 11rpx 18rpx;
  border: 1rpx solid rgba(77, 139, 255, 0.35);
  border-radius: 10rpx;
  background: rgba(55, 117, 236, 0.12);
  color: #68a0ff;
  font-size: 21rpx;
}

.add-icon {
  font-size: 29rpx;
  line-height: 1;
}

.summary {
  justify-content: flex-start;
  padding: 21rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 16rpx;
  background: #131a25;
}

.summary-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}

.summary-wide {
  flex: 1.6;
}

.summary-divider {
  width: 1rpx;
  height: 43rpx;
  background: rgba(255, 255, 255, 0.08);
}

.summary-value {
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.summary-alert {
  color: #ff5959;
}

.summary-time {
  color: #d8dee9;
  font-size: 18rpx;
}

.summary-label {
  color: #657185;
  font-size: 18rpx;
}

.search-panel {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(69, 136, 255, 0.25);
  border-radius: 17rpx;
  background: #121a27;
}

.search-box {
  display: flex;
  align-items: center;
  height: 74rpx;
  padding-left: 19rpx;
  border: 1rpx solid #273348;
  border-radius: 12rpx;
  background: #0c1119;
}

.search-icon {
  margin-right: 13rpx;
  color: #69778c;
  font-size: 31rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #fff;
  font-size: 24rpx;
}

.search-placeholder {
  color: #4d596c;
}

.search-action {
  height: 74rpx;
  padding: 0 22rpx;
  border-left: 1rpx solid #273348;
  color: #69a0ff;
  font-size: 22rpx;
  line-height: 74rpx;
}

.search-state {
  padding: 32rpx 10rpx 13rpx;
  color: #667286;
  font-size: 21rpx;
  text-align: center;
}

.search-results {
  margin-top: 9rpx;
}

.search-result {
  padding: 18rpx 6rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.result-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 5rpx;
}

.result-symbol {
  color: #64a0ff;
  font-size: 25rpx;
  font-weight: 750;
}

.result-name {
  max-width: 440rpx;
  overflow: hidden;
  color: #99a5b8;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.result-exchange {
  color: #566276;
  font-size: 17rpx;
}

.result-add {
  padding: 6rpx 13rpx;
  border-radius: 7rpx;
  background: rgba(65, 133, 255, 0.14);
  color: #67a0ff;
  font-size: 19rpx;
}

.direct-add {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: rgba(63, 126, 240, 0.08);
  color: #77849a;
  font-size: 20rpx;
}

.direct-symbol {
  color: #67a0ff;
  font-weight: 700;
}

.error-bar {
  margin-top: 17rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(239, 76, 76, 0.09);
  color: #e98282;
  font-size: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 27rpx 4rpx 14rpx;
}

.section-title {
  color: #dfe5ef;
  font-size: 25rpx;
  font-weight: 700;
}

.section-note {
  color: #505d70;
  font-size: 18rpx;
}

.stock-card {
  margin-bottom: 17rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 18rpx;
  background: #151d2a;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.18);
}

.stock-head {
  align-items: flex-start;
}

.stock-identity {
  min-width: 0;
  flex: 1;
}

.symbol-line {
  justify-content: flex-start;
  gap: 12rpx;
}

.symbol {
  color: #67a0ff;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.stock-name {
  display: block;
  max-width: 410rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: #aab4c5;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quote {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 15rpx;
}

.price {
  color: #fff;
  font-size: 29rpx;
  font-weight: 750;
}

.change {
  margin-top: 5rpx;
  font-size: 19rpx;
  font-weight: 650;
}

.rise {
  color: #ff6868;
}

.fall {
  color: #36cf89;
}

.target-status {
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  background: rgba(68, 132, 245, 0.11);
  color: #78a8ff;
  font-size: 17rpx;
}

.target-hit {
  background: rgba(255, 69, 69, 0.13);
  color: #ff5f5f;
  font-weight: 700;
}

.target-neutral {
  background: rgba(140, 150, 165, 0.1);
  color: #707d90;
}

.target-row {
  margin-top: 19rpx;
  padding: 15rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.target-label {
  color: #657185;
  font-size: 18rpx;
}

.target-price {
  margin-left: 10rpx;
  color: #d6dde9;
  font-size: 21rpx;
  font-weight: 700;
}

.target-actions {
  justify-content: flex-end;
  gap: 15rpx;
}

.source {
  color: #4f5c70;
  font-size: 17rpx;
}

.text-action,
.remove-action {
  color: #6fa5ff;
  font-size: 18rpx;
}

.remove-action {
  color: #747f91;
}

.news-block {
  padding-top: 18rpx;
}

.news-head {
  margin-bottom: 6rpx;
}

.news-title {
  color: #c8d0dd;
  font-size: 20rpx;
  font-weight: 650;
}

.news-count {
  color: #525f73;
  font-size: 17rpx;
}

.news-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.news-item:last-child {
  border-bottom: 0;
}

.news-dot {
  flex: none;
  width: 7rpx;
  height: 7rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: #4a8cff;
}

.news-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.news-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.news-text {
  color: #e3e8f0;
  font-size: 21rpx;
  line-height: 1.48;
}

.news-meta {
  color: #586579;
  font-size: 17rpx;
}

.news-source-link {
  color: #6da2ff;
  font-size: 17rpx;
  text-decoration: underline;
  text-decoration-color: rgba(109, 162, 255, 0.5);
}

.news-toggle {
  margin-top: 13rpx;
  padding: 14rpx 0 2rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  color: #6ea3ff;
  font-size: 19rpx;
  text-align: center;
}

.no-news {
  padding: 17rpx 0 5rpx;
  color: #586579;
  font-size: 19rpx;
  font-style: italic;
}

.state,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 110rpx 35rpx;
  color: #657185;
  font-size: 22rpx;
}

.loader {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: #498cff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid #344156;
  border-radius: 50%;
  color: #68a0ff;
  font-size: 39rpx;
  line-height: 68rpx;
  text-align: center;
}

.empty-title {
  margin-top: 19rpx;
  color: #d9e0eb;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 10rpx;
  color: #647084;
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
}

.empty-button {
  margin-top: 23rpx;
  padding: 13rpx 25rpx;
  border-radius: 9rpx;
  background: #377ae9;
  color: #fff;
}

.footer-note {
  padding: 15rpx 25rpx 0;
  color: #485468;
  font-size: 17rpx;
  line-height: 1.5;
  text-align: center;
}

.footer-space {
  height: 50rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.target-modal {
  width: 100%;
  padding: 29rpx 27rpx calc(35rpx + env(safe-area-inset-bottom));
  border-radius: 25rpx 25rpx 0 0;
  background: #171f2c;
  box-sizing: border-box;
}

.modal-head {
  align-items: flex-start;
  margin-bottom: 27rpx;
}

.modal-symbol {
  display: block;
  color: #6ba3ff;
  font-size: 31rpx;
  font-weight: 800;
}

.modal-name {
  display: block;
  max-width: 580rpx;
  margin-top: 5rpx;
  color: #778398;
  font-size: 19rpx;
}

.modal-close {
  color: #717d90;
  font-size: 40rpx;
  line-height: 1;
}

.field-label {
  display: block;
  margin: 22rpx 0 11rpx;
  color: #98a4b7;
  font-size: 20rpx;
}

.type-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13rpx;
}

.type-option {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  padding: 17rpx;
  border: 1rpx solid #2b374a;
  border-radius: 11rpx;
  color: #9ba7b9;
  font-size: 22rpx;
}

.type-active {
  border-color: #4388f5;
  background: rgba(55, 122, 233, 0.12);
  color: #74a8ff;
}

.type-desc {
  color: #59667a;
  font-size: 17rpx;
}

.target-input-wrap {
  display: flex;
  align-items: center;
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #2d394c;
  border-radius: 11rpx;
  background: #0e141e;
}

.currency {
  margin-right: 8rpx;
  color: #68758a;
  font-size: 30rpx;
}

.target-input {
  flex: 1;
  height: 82rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.confirm-button {
  margin-top: 28rpx;
  height: 82rpx;
  border-radius: 11rpx;
  background: #397ce9;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
}
