<view class="page">
  <view class="header">
    <view>
      <text class="title">AI投研</text>
      <text class="subtitle">客观数据先行，结论保留依据与缺口</text>
    </view>
    <text class="updated">{{updatedAt}}</text>
  </view>

  <view class="ai-status {{aiClass}}">
    <view class="ai-dot"></view>
    <view class="ai-copy">
      <text class="ai-title">{{aiTitle}}</text>
      <text class="ai-desc">{{ai.message}}</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">市场温度</text>
    <text class="section-tip">下拉刷新</text>
  </view>

  <view wx:if="{{loading}}" class="state">正在读取全球市场</view>
  <view wx:elif="{{showIndexError}}" class="state state-error">{{error}}</view>
  <view wx:else class="index-grid">
    <view class="index-card" wx:for="{{indices}}" wx:key="code">
      <text class="index-name">{{item.name}}</text>
      <view class="index-line">
        <text class="index-price">{{item.priceText}}</text>
        <text class="{{item.changeCls}}">{{item.changeText}}</text>
      </view>
    </view>
  </view>

  <view class="action-grid">
    <view class="action-card action-primary" bindtap="onRunReview">
      <text class="action-icon">复</text>
      <text class="action-name">今日复盘</text>
      <text class="action-desc">市场事实与跟踪清单</text>
    </view>
    <view class="action-card" bindtap="onRunResearch">
      <text class="action-icon">研</text>
      <text class="action-name">个股研究</text>
      <text class="action-desc">估值、财务、资金与风险</text>
    </view>
    <view class="action-card" bindtap="onRunDebate">
      <text class="action-icon">辩</text>
      <text class="action-name">多空辩论</text>
      <text class="action-desc">共识、分歧与验证事项</text>
    </view>
  </view>

  <view class="section-head stock-head">
    <text class="section-title">个股研究</text>
    <text class="section-tip">A股 · 港股 · 美股</text>
  </view>
  <view class="search-box">
    <input
      class="search-input"
      value="{{query}}"
      placeholder="输入股票名称或代码"
      bindinput="onQueryInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-button" bindtap="onSearch">搜索</view>
  </view>
  <text class="search-message">{{searchMessage}}</text>

  <view class="search-results" wx:if="{{searchItems.length}}">
    <view
      class="search-item"
      wx:for="{{searchItems}}"
      wx:key="quote_code"
      data-quote-code="{{item.quote_code}}"
      bindtap="onSelectAsset"
    >
      <view>
        <text class="search-name">{{item.name}}</text>
        <text class="search-symbol">{{item.symbol}} · {{item.security_type}}</text>
      </view>
      <text class="market-tag">{{item.market}}</text>
    </view>
  </view>

  <view class="asset-card" wx:if="{{asset}}">
    <view class="asset-head">
      <view>
        <text class="asset-name">{{asset.name}}</text>
        <text class="asset-symbol">{{asset.symbol}} · {{asset.source}}</text>
      </view>
      <view class="asset-price-box">
        <text class="asset-price">{{asset.priceText}}</text>
        <text class="{{asset.changeCls}}">{{asset.changeText}}</text>
      </view>
    </view>
    <view class="metric-grid">
      <view class="metric"><text class="metric-value">{{asset.peText}}</text><text class="metric-label">市盈率</text></view>
      <view class="metric"><text class="metric-value">{{asset.pbText}}</text><text class="metric-label">市净率</text></view>
      <view class="metric"><text class="metric-value">{{asset.turnoverText}}</text><text class="metric-label">换手率</text></view>
      <view class="metric"><text class="metric-value">{{asset.marketCapText}}</text><text class="metric-label">总市值</text></view>
    </view>
    <view class="asset-actions">
      <view class="small-button" bindtap="onRunResearch">生成研究</view>
      <view class="small-button small-button-dark" bindtap="onRunDebate">多空辩论</view>
    </view>
  </view>

  <view class="dossier-loading" wx:if="{{dossierLoading}}">正在整理财务、公告、研报和资金数据…</view>

  <view class="dossier" wx:if="{{dossier}}">
    <view class="dossier-summary">
      <view>
        <text class="dossier-title">客观研究底稿</text>
        <text class="dossier-scope">{{dossier.market_scope}} · {{dossier.updated_at}}</text>
      </view>
      <text class="dossier-count">{{dossier.completeness.available}}/{{dossier.completeness.total}}</text>
    </view>

    <view class="data-section" wx:if="{{dossier.valuation.available}}">
      <view class="data-section-head">
        <view>
          <text class="data-title">估值概览</text>
          <text class="data-subtitle">当前估值与机构一致预期</text>
        </view>
        <text class="source-action" wx:if="{{dossier.valuation.source_url}}" data-url="{{dossier.valuation.source_url}}" bindtap="onOpenSource">来源</text>
      </view>
      <view class="flow-grid">
        <view class="flow-item"><text class="flow-value">{{dossier.valuation.peText}}</text><text class="flow-label">当前 PE</text></view>
        <view class="flow-item"><text class="flow-value">{{dossier.valuation.pbText}}</text><text class="flow-label">当前 PB</text></view>
        <view class="flow-item"><text class="flow-value">{{dossier.valuation.forwardPeText}}</text><text class="flow-label">机构预测 PE</text></view>
      </view>
      <text class="valuation-tip">{{dossier.valuation.report_count}} 份研报参与统计 · {{dossier.valuation.message}}</text>
    </view>

    <view class="data-section" wx:if="{{dossier.financials.available}}">
      <view class="data-section-head">
        <view>
          <text class="data-title">财务摘要</text>
          <text class="data-subtitle">{{dossier.financials.period}}</text>
        </view>
        <text class="source-action" data-url="{{dossier.financials.source_url}}" bindtap="onOpenSource">来源</text>
      </view>
      <view class="financial-grid">
        <view class="financial-item"><text class="financial-value">{{dossier.financials.revenueText}}</text><text class="financial-label">营业收入</text><text class="financial-yoy">同比 {{dossier.financials.revenueYoyText}}</text></view>
        <view class="financial-item"><text class="financial-value">{{dossier.financials.netProfitText}}</text><text class="financial-label">归母净利润</text><text class="financial-yoy">同比 {{dossier.financials.netProfitYoyText}}</text></view>
        <view class="financial-item"><text class="financial-value">{{dossier.financials.roeText}}</text><text class="financial-label">ROE</text></view>
        <view class="financial-item"><text class="financial-value">{{dossier.financials.grossMarginText}}</text><text class="financial-label">毛利率</text></view>
        <view class="financial-item"><text class="financial-value">{{dossier.financials.netMarginText}}</text><text class="financial-label">净利率</text></view>
        <view class="financial-item"><text class="financial-value">{{dossier.financials.debtRatioText}}</text><text class="financial-label">资产负债率</text></view>
      </view>
    </view>

    <view class="data-section" wx:if="{{dossier.fund_flow.available}}">
      <view class="data-section-head">
        <view>
          <text class="data-title">资金面</text>
          <text class="data-subtitle">{{dossier.fund_flow.date}}</text>
        </view>
        <text class="source-action" data-url="{{dossier.fund_flow.source_url}}" bindtap="onOpenSource">来源</text>
      </view>
      <view class="flow-grid">
        <view class="flow-item"><text class="{{dossier.fund_flow.mainNetCls}}">{{dossier.fund_flow.mainNetText}}</text><text class="flow-label">主力净额</text></view>
        <view class="flow-item"><text class="flow-value">{{dossier.fund_flow.largeNetText}}</text><text class="flow-label">大单净额</text></view>
        <view class="flow-item"><text class="flow-value">{{dossier.fund_flow.superLargeNetText}}</text><text class="flow-label">超大单净额</text></view>
      </view>
    </view>

    <view class="data-section" wx:if="{{dossier.announcements.available}}">
      <view class="data-section-head">
        <text class="data-title">最新公告</text>
        <text class="source-action" data-url="{{dossier.announcements.source_url}}" bindtap="onOpenSource">全部公告</text>
      </view>
      <view class="document-row" wx:for="{{dossier.announcements.items}}" wx:key="url" data-url="{{item.url}}" bindtap="onOpenSource">
        <view class="document-main">
          <text class="document-title">{{item.title}}</text>
          <text class="document-meta">{{item.date}} · {{item.type}}</text>
        </view>
        <text class="document-link">原文</text>
      </view>
    </view>

    <view class="data-section" wx:if="{{dossier.reports.available}}">
      <view class="data-section-head">
        <text class="data-title">机构研报</text>
        <text class="source-action" data-url="{{dossier.reports.source_url}}" bindtap="onOpenSource">全部研报</text>
      </view>
      <view class="document-row" wx:for="{{dossier.reports.items}}" wx:key="url" data-url="{{item.url}}" bindtap="onOpenSource">
        <view class="document-main">
          <text class="document-title">{{item.title}}</text>
          <text class="document-meta">{{item.date}} · {{item.organization}} · {{item.ratingText}}</text>
        </view>
        <text class="document-link">原文</text>
      </view>
    </view>

    <view class="missing-data" wx:if="{{dossier.hasMissingData}}">
      缺失项目会在AI分析中标记为“数据不足”,不会推测补全。
    </view>
  </view>

  <view class="task-card" wx:if="{{activeTask}}">
    <view class="task-head">
      <text class="task-title">{{activeTask.title}}</text>
      <text class="task-progress">{{activeTask.progress}}%</text>
    </view>
    <view class="progress-track"><view class="progress-value" style="{{activeTask.progressStyle}}"></view></view>
    <text class="task-stage">{{activeTask.stage}}</text>
    <text class="task-error" wx:if="{{activeTask.error}}">{{activeTask.error}}</text>
    <text class="task-result" wx:if="{{activeTask.result}}">{{activeTask.result}}</text>
  </view>

  <view class="section-head note-head">
    <text class="section-title">研究记录</text>
    <text class="section-tip">保存于自己的后端</text>
  </view>
  <view class="note-editor">
    <input class="note-title-input" value="{{noteTitle}}" placeholder="标题（可选）" bindinput="onNoteTitleInput" />
    <textarea class="note-content-input" value="{{noteContent}}" placeholder="记录观点、依据和需要继续验证的问题" maxlength="50000" bindinput="onNoteContentInput"></textarea>
    <view class="save-note" bindtap="onSaveNote">保存记录</view>
  </view>

  <view class="note-list" wx:if="{{notes.length}}">
    <view class="note-card" wx:for="{{notes}}" wx:key="id">
      <view class="note-card-head">
        <view>
          <text class="note-card-title">{{item.title}}</text>
          <text class="note-meta">{{item.symbolText}} · {{item.updated_at}}</text>
        </view>
        <text class="delete-note" data-id="{{item.id}}" bindtap="onDeleteNote">删除</text>
      </view>
      <text class="note-body">{{item.content}}</text>
    </view>
  </view>

  <view class="disclaimer">仅整理公开数据与研究过程，不预测涨跌，不构成投资建议。</view>
  <view class="footer-space"></view>
</view>
