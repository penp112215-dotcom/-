page {
  background: #07090d;
  color: #edf2f7;
}

.page {
  min-height: 100vh;
  padding: 32rpx 26rpx 0;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 95% 0%, rgba(28, 104, 255, 0.13), transparent 34%),
    #07090d;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 4rpx 30rpx;
}

.eyebrow {
  display: block;
  color: #48d2ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin: 8rpx 0;
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
}

.subtitle {
  color: #718096;
  font-size: 20rpx;
}

.sync {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 4rpx;
}

.sync-label {
  color: #455166;
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.sync-time {
  width: 180rpx;
  margin-top: 6rpx;
  color: #8492a6;
  font-size: 18rpx;
  text-align: right;
}

.account-card,
.fund-card {
  border: 1rpx solid rgba(123, 151, 190, 0.16);
  border-radius: 20rpx;
  background: linear-gradient(145deg, #111722, #0d1119);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.28);
}

.account-card {
  padding: 26rpx;
}

.account-top,
.card-head,
.detail-row,
.premium-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
}

.broker-tag {
  padding: 5rpx 14rpx;
  border: 1rpx solid rgba(72, 210, 255, 0.3);
  border-radius: 6rpx;
  color: #48d2ff;
  font-size: 18rpx;
}

.account-grid,
.scan-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.account-grid {
  margin-top: 24rpx;
}

.metric,
.scan-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
}

.metric + .metric,
.scan-cell + .scan-cell {
  border-left: 1rpx solid rgba(255, 255, 255, 0.07);
}

.metric-value {
  font-size: 29rpx;
  font-weight: 800;
}

.metric-label,
.scan-label,
.small-label,
.detail-label {
  color: #68758a;
  font-size: 19rpx;
}

.account-note {
  display: block;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  color: #59677b;
  font-size: 19rpx;
}

.scan-grid {
  margin: 20rpx 0;
  padding: 22rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  background: rgba(11, 15, 23, 0.82);
}

.scan-value {
  font-size: 30rpx;
  font-weight: 800;
}

.scan-value.accent {
  color: #ffbf47;
}

.notice {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border-left: 5rpx solid #ffbf47;
  border-radius: 8rpx;
  background: rgba(255, 191, 71, 0.08);
  color: #cfae69;
  font-size: 20rpx;
  line-height: 1.55;
}

.filters {
  width: 100%;
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 12rpx;
}

.filter {
  flex: none;
  padding: 12rpx 26rpx;
  border: 1rpx solid #202a39;
  border-radius: 999rpx;
  color: #748198;
  font-size: 22rpx;
}

.filter-active {
  border-color: #2f7fff;
  background: rgba(47, 127, 255, 0.16);
  color: #72a8ff;
}

.fund-card {
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.fund-card-positive {
  border-color: rgba(255, 94, 94, 0.24);
}

.fund-title {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  max-width: 490rpx;
}

.fund-name {
  color: #f7fafc;
  font-size: 30rpx;
  font-weight: 750;
}

.fund-code {
  color: #66758a;
  font-size: 19rpx;
}

.signal {
  padding: 7rpx 13rpx;
  border-radius: 7rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.signal-ready {
  color: #ff6d6d;
  background: rgba(255, 78, 78, 0.13);
}

.signal-verify {
  color: #ffbf47;
  background: rgba(255, 191, 71, 0.12);
}

.signal-watch {
  color: #56c8ff;
  background: rgba(86, 200, 255, 0.11);
}

.signal-closed,
.signal-none {
  color: #7c8798;
  background: rgba(124, 135, 152, 0.11);
}

.premium-row {
  margin: 25rpx 0 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.premium-row > view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.premium-cell {
  align-items: flex-end;
}

.price {
  font-size: 38rpx;
  font-weight: 800;
}

.premium {
  color: #ff7777;
  font-size: 31rpx;
  font-weight: 800;
}

.net-edge {
  color: #ffbf47;
  font-size: 31rpx;
  font-weight: 800;
}

.detail-row {
  padding: 10rpx 0;
}

.detail-value {
  color: #b8c3d3;
  font-size: 22rpx;
}

.detail-value.strong {
  color: #fff;
  font-weight: 700;
}

.detail-value.profit {
  color: #ff7474;
  font-weight: 700;
}

.risk-box {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-top: 17rpx;
  padding: 17rpx;
  border-radius: 10rpx;
  background: rgba(4, 7, 11, 0.54);
  color: #5f6d81;
  font-size: 18rpx;
  line-height: 1.45;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 100rpx 20rpx;
  color: #66758a;
  font-size: 23rpx;
}

.state-error {
  color: #ff7777;
}

.loader {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: #3f8cff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.footer-space {
  height: 50rpx;
}
