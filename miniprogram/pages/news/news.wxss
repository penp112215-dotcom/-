page { background: #f4f6fa; color: #172033; }
.page { min-height: 100vh; padding: 34rpx 26rpx; box-sizing: border-box; }
.header { display: flex; justify-content: space-between; align-items: flex-end; }
.eyebrow { display: block; color: #3475df; font-size: 16rpx; font-weight: 750; letter-spacing: 2rpx; }
.title { display: block; margin-top: 6rpx; font-size: 46rpx; font-weight: 850; }
.subtitle { display: block; margin-top: 5rpx; color: #7c8798; font-size: 19rpx; }
.date-box { text-align: right; }.date { display: block; font-size: 19rpx; font-weight: 700; }.updated { display: block; margin-top: 5rpx; color: #9aa3b0; font-size: 14rpx; }
.digest-card { margin-top: 22rpx; padding: 19rpx 21rpx; border: 1rpx solid #dce7fa; border-radius: 16rpx; background: #edf4ff; }
.digest-label { display: block; color: #2e6ed2; font-size: 16rpx; font-weight: 750; }.digest-copy { display: block; margin-top: 5rpx; color: #52647d; font-size: 18rpx; line-height: 1.5; }
.tab-bar { width: 100%; margin-top: 23rpx; white-space: nowrap; }
.tab-item { display: inline-flex; align-items: center; gap: 8rpx; margin-right: 10rpx; padding: 15rpx 21rpx; border: 1rpx solid #e0e4eb; border-radius: 999rpx; background: #fff; color: #738095; }
.tab-active { border-color: #2d6fe0; background: #2d6fe0; color: #fff; }
.tab-name { font-size: 21rpx; font-weight: 750; }.tab-count { min-width: 27rpx; height: 27rpx; border-radius: 999rpx; background: rgba(128,142,165,.16); font-size: 14rpx; line-height: 27rpx; text-align: center; }
.tab-active .tab-count { background: rgba(255,255,255,.2); }
.channel-head { margin: 28rpx 3rpx 14rpx; }.channel-title { display: block; font-size: 27rpx; font-weight: 820; }.channel-description { display: block; margin-top: 5rpx; color: #8a94a4; font-size: 16rpx; }
.news-card { margin-bottom: 13rpx; padding: 21rpx; border: 1rpx solid #e2e6ed; border-radius: 17rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(26,39,61,.035); }
.news-meta,.card-actions { display: flex; justify-content: space-between; align-items: center; }
.source-wrap { display: flex; min-width: 0; align-items: center; gap: 8rpx; }
.source-tag { max-width: 70%; overflow: hidden; color: #2f72dc; font-size: 16rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.news-time { color: #9ba4b2; font-size: 15rpx; }
.tier-tag,.translated-tag { flex: none; padding: 3rpx 7rpx; border-radius: 7rpx; background: #edf2f8; color: #778499; font-size: 12rpx; }
.translated-tag { background: #edf8f1; color: #27814d; }
.news-title { display: block; margin-top: 13rpx; color: #253146; font-size: 22rpx; font-weight: 700; line-height: 1.55; }
.news-summary { display: block; margin-top: 13rpx; padding: 14rpx; border-radius: 10rpx; background: #f6f8fb; color: #667286; font-size: 18rpx; line-height: 1.55; }
.card-actions { justify-content: flex-end; gap: 25rpx; margin-top: 15rpx; padding-top: 13rpx; border-top: 1rpx solid #eef1f5; }
.summary-action { color: #778499; font-size: 16rpx; }.source-action { color: #2f72dc; font-size: 16rpx; font-weight: 700; }
.feed-route { margin-right: auto; max-width: 42%; overflow: hidden; color: #9aa4b2; font-size: 13rpx; text-overflow: ellipsis; white-space: nowrap; }
.state { padding: 70rpx 20rpx; color: #8d97a6; font-size: 20rpx; text-align: center; }.state-error { color: #cf5959; }
.disclaimer { display: block; margin-top: 24rpx; padding: 0 16rpx; color: #9ba4b0; font-size: 15rpx; line-height: 1.55; text-align: center; }
.footer-space { height: 45rpx; }
