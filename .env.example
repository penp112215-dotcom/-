# 可选 AI 投研配置（使用服务商的官方 OpenAI-compatible 地址）。
# 这里只能保留占位符；真实密钥必须由本机 Shell、systemd、容器或密钥管理服务注入。
AI_PROVIDER=your-provider-name
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=replace-with-your-secret
AI_MODEL=replace-with-model-id
AI_TIMEOUT=180

# 可选美股增强数据。
# 只配置在后端运行环境，禁止写入小程序源码或提交真实密钥。
FINNHUB_API_KEY=replace-with-your-finnhub-key

# 可选运行数据目录。默认数据库位于项目 data/ 下，并已被 Git 忽略。
# RESEARCH_DB_PATH=/var/lib/market-radar/research.db
# ARBITRAGE_DB_PATH=/var/lib/market-radar/arbitrage_history.db
