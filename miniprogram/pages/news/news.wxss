.page {
  background-color: #0d1117;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-grid {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  z-index: 0; pointer-events: none;
}

.header {
  position: relative; z-index: 1; margin-bottom: 24rpx; padding-left: 8rpx;
}

.title {
  color: #f0f6fc; font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx; font-family: monospace;
}

.subtitle {
  color: #8b949e; font-size: 22rpx; margin-top: 8rpx; display: flex; align-items: center;
}

.time-badge {
  color: #58a6ff; background: rgba(56, 139, 253, 0.15); padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 16rpx; font-size: 18rpx;
}

/* 💎 横向滑动导航栏样式 */
.tab-bar {
  white-space: nowrap;
  width: 100%;
  height: 80rpx;
  position: relative; z-index: 1;
  margin-bottom: 24rpx;
  border-bottom: 1px solid #21262d;
}

.tab-item {
  display: inline-block;
  padding: 0 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  color: #8b949e;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-active {
  color: #58a6ff;
  font-weight: bold;
  border-bottom: 4rpx solid #58a6ff;
  font-size: 30rpx;
}

/* 时间线列表布局 */
.list-container {
  position: relative; z-index: 1; height: calc(100vh - 240rpx);
}

.news-timeline {
  padding-left: 20rpx;
  position: relative;
}
/* 左侧时间线中轴虚线 */
.news-timeline::before {
  content: ''; position: absolute; top: 10rpx; left: 30rpx; bottom: 0;
  width: 2rpx; background: #30363d;
}

.card-wrapper {
  margin-bottom: 32rpx;
  position: relative;
}

/* 时间轴节点 */
.time-node {
  display: flex; align-items: center; margin-bottom: 12rpx; position: relative; z-index: 2;
}

.node-dot {
  width: 12rpx; height: 12rpx; background: #58a6ff; border-radius: 50%;
  margin-left: 5rpx; margin-right: 20rpx;
  box-shadow: 0 0 12rpx #58a6ff;
}

.node-time {
  color: #8b949e; font-size: 22rpx; font-family: monospace;
}

/* 新闻暗黑卡片样式 */
.news-card {
  background-color: #161b22;
  border: 1px solid #30363d;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-left: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
}

.news-title {
  color: #e6edf3; font-size: 28rpx; line-height: 1.6; font-weight: 400;
}

.card-footer {
  display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-top: 16rpx; border-top: 1px solid #21262d;
}

.source-tag {
  color: #58a6ff; font-size: 20rpx; background: rgba(88, 166, 255, 0.1); padding: 4rpx 12rpx; border-radius: 6rpx; border: 1px solid rgba(88,166,255,0.2);
}

.action-hint {
  color: #2ea043; font-size: 18rpx; font-weight: bold; letter-spacing: 1rpx;
}

.empty-tip {
  color: #8b949e; text-align: center; font-size: 26rpx; padding-top: 100rpx;
}