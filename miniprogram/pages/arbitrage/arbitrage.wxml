<view class="page">
  <view class="header">
    <view>
      <text class="title">基金套利</text>
      <text class="subtitle">只展示扣除成本和安全垫后的结果</text>
    </view>
    <view class="refresh" bindtap="onRefresh">
      <text class="refresh-icon">↻</text>
      <text>{{displayUpdatedAt}}</text>
    </view>
  </view>

  <view class="overview">
    <view class="overview-main">
      <view>
        <text class="overview-label">当前值得核实</text>
        <view class="overview-number-line">
          <text class="overview-number">{{summary.need_verification}}</text>
          <text class="overview-unit">只</text>
        </view>
      </view>
      <view class="account-pill">
        <text>{{account.investors}} 人账户</text>
        <text>总资金 {{accountTotalText}}</text>
      </view>
    </view>
    <view class="overview-stats">
      <view class="overview-stat">
        <text class="stat-value">{{summary.market_total}}</text>
        <text class="stat-label">全市场扫描</text>
      </view>
      <view class="overview-stat">
        <text class="stat-value">{{summary.analyzed}}</text>
        <text class="stat-label">深度分析</text>
      </view>
      <view class="overview-stat">
        <text class="stat-value">{{summary.watching}}</text>
        <text class="stat-label">进入观察</text>
      </view>
    </view>
  </view>

  <view class="notice" wx:if="{{message}}">
    <text class="notice-dot">!</text>
    <text class="notice-text">{{message}}</text>
  </view>

  <view class="alert-panel" wx:if="{{alerts.length}}">
    <view class="alert-head">
      <text>今日状态变化</text>
      <text>{{alerts.length}} 条</text>
    </view>
    <view class="alert-item" wx:for="{{alerts}}" wx:key="code">
      <text class="alert-title">{{item.name}} {{item.code}}</text>
      <text class="alert-detail">{{item.detail}}</text>
    </view>
  </view>

  <scroll-view scroll-x class="filters" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onFilterTap"
        class="filter {{activeFilter === item.key ? 'filter-active' : ''}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="list-head" wx:if="{{!loading && !error}}">
    <text class="list-title">按预计净空间排序</text>
    <text class="list-count">共 {{items.length}} 只</text>
  </view>

  <view wx:if="{{loading}}" class="state">
    <view class="loader"></view>
    <text>正在更新套利数据</text>
  </view>

  <view wx:elif="{{error}}" class="state state-error">
    <text class="state-title">数据暂不可用</text>
    <text class="state-desc">{{error}}</text>
    <view class="retry" bindtap="fetch">重新加载</view>
  </view>

  <block wx:else>
    <view
      wx:for="{{items}}"
      wx:key="code"
      class="{{item.cardCls}}"
      data-code="{{item.code}}"
      bindtap="onItemTap"
    >
      <view class="card-head">
        <view class="fund-title">
          <view class="name-line">
            <text class="fund-name">{{item.name}}</text>
            <text class="{{item.signalCls}}">{{item.signalText}}</text>
            <text class="changed-tag" wx:if="{{item.status_changed}}">有变化</text>
          </view>
          <text class="fund-code">{{item.code}} · {{item.fund_type}}</text>
        </view>
        <view class="edge">
          <text class="edge-label">保守净空间</text>
          <text class="{{item.edgeCls}}">{{item.netText}}</text>
        </view>
      </view>

      <view class="money-grid">
        <view class="money-cell">
          <text class="money-value">{{item.perInvestorText}}</text>
          <text class="money-label">每人建议申购</text>
        </view>
        <view class="money-cell">
          <text class="money-value">{{item.capacityText}}</text>
          <text class="money-label">8 人合计</text>
        </view>
        <view class="money-cell">
          <text class="money-value profit">{{item.profitText}}</text>
          <text class="money-label">预计空间金额</text>
        </view>
      </view>

      <view class="quick-info">
        <text>{{item.subscription_status}}</text>
        <text class="quick-divider">·</text>
        <text>较3日均值</text>
        <text class="{{item.trendCls}}">{{item.trendText}}</text>
        <text class="expand">{{item.expanded ? '收起' : '详情'}} {{item.expanded ? '⌃' : '⌄'}}</text>
      </view>

      <view class="details" wx:if="{{item.expanded}}">
        <view class="nav-grid">
          <view class="nav-cell">
            <text class="nav-value">{{item.officialNavText}}</text>
            <text class="nav-caption">确认净值</text>
          </view>
          <view class="nav-cell">
            <text class="nav-value">{{item.estimatedNavText}}</text>
            <text class="nav-caption">盘中估值</text>
          </view>
          <view class="nav-cell">
            <text class="nav-value">{{item.average3dText}}</text>
            <text class="nav-caption">3日平均溢价</text>
          </view>
        </view>
        <view class="detail-row">
          <text class="detail-label">可执行价格</text>
          <text class="detail-value">{{item.priceText}}（{{item.pricing_basis}}）</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">本次计算基准</text>
          <text class="detail-value">{{item.nav_label}} {{item.navText}} · {{item.nav_date}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">毛溢价</text>
          <text class="detail-value">{{item.grossText}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">费后理论空间</text>
          <text class="detail-value">{{item.feeAdjustedText}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">限额口径</text>
          <text class="detail-value detail-wrap">{{item.limit_scope}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">当日成交额</text>
          <text class="detail-value">{{item.amountText}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">历史样本</text>
          <text class="detail-value">{{item.history_samples}} 个5分钟快照 · 可信度 {{item.confidenceText}}</text>
        </view>
        <view class="cost-line">
          申购 {{item.subscription_fee_pct}}% · 卖出 {{item.sell_fee_pct}}% ·
          滑点 {{item.slippage_pct}}% · 安全垫 {{item.safety_buffer_pct}}%
        </view>
      </view>
    </view>

    <view wx:if="{{items.length === 0}}" class="state">
      <text class="state-title">当前分类暂无基金</text>
      <text class="state-desc">下拉刷新后再看看</text>
    </view>
  </block>

  <view class="disclaimer">
    结果用于筛选，不代表确定收益。申购前请以基金公告和银河证券页面为准。
  </view>
  <view class="footer-space"></view>
</view>
